# ──────────────────────────────────────────────────────────────────────────────
# Example environment configuration. Copy to `.env.local` and fill in real values.
# This file contains NO secrets — only variable names and placeholder formats.
# Never commit real keys / connection strings.
# ──────────────────────────────────────────────────────────────────────────────

# ── Persistence backend (PostgreSQL) ──────────────────────────────────────────
# When DATABASE_URL is set, the ONDC store uses PostgreSQL (src/lib/db.ts ->
# store-db.ts) — shared and consistent across all serverless instances. When it
# is UNSET, the app falls back to the per-instance JSON store (store-json.ts),
# which fragments state on multi-instance serverless. See docs/POSTGRES_DEPLOYMENT.md.
#
# DATABASE_URL = runtime connection. On serverless (Vercel) use the POOLED string.
DATABASE_URL="postgresql://USER:PASSWORD@POOLED_HOST:6543/postgres?pgbouncer=true"
# DIRECT_URL = migration-time connection (Prisma CLI). Use the DIRECT (un-pooled)
# string; pgbouncer cannot run migration DDL. Optional if your provider accepts
# DDL on DATABASE_URL directly.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres"

# Optional: only relevant to the JSON fallback (write-through Blob snapshot).
# Not used when DATABASE_URL is set. Leave unset to use Postgres.
# BLOB_READ_WRITE_TOKEN=""

# ── ONDC participant identity (required) ───────────────────────────────────────
# ONDC_ENV is the NETWORK SWITCH. Every ONDC_* variable below also accepts an
# env-scoped variant — ONDC_PREPROD_<NAME> / ONDC_PROD_<NAME> / ONDC_STAGING_
# <NAME> — which WINS over the plain name while ONDC_ENV selects that network
# (see readOndcScopedEnv in src/lib/ondc/config.ts). This lets one environment
# hold BOTH credential sets, e.g.:
#   ONDC_ENV="preprod"
#   ONDC_PREPROD_SIGNING_PRIVATE_KEY="..."   # active
#   ONDC_PROD_SIGNING_PRIVATE_KEY="..."      # dormant until ONDC_ENV="prod"
# Keep per-network secrets ONLY under scoped names so switching with an
# incomplete set fails loudly instead of falling back to the other network's keys.
#
# LOCAL DEV uses per-network files instead (plain names + ONDC_ENV inside):
#   .env.preprod / .env.prod  — loaded explicitly by `npm run dev[:preprod]` /
#   `npm run dev:prod` via dotenv-cli; .env.local keeps only shared config.
# The scoped names are the VERCEL representation, where no env files exist.
ONDC_ENV="staging"                       # staging | preprod | prod
ONDC_SUBSCRIBER_ID="your-subscriber-id"
ONDC_SUBSCRIBER_URI="https://your-domain"
ONDC_UNIQUE_KEY_ID="your-unique-key-id"
ONDC_SIGNING_PUBLIC_KEY="base64-ed25519-public-key"
ONDC_SIGNING_PRIVATE_KEY="base64-ed25519-private-key"
ONDC_ENCRYPTION_PUBLIC_KEY="base64-x25519-public-key"
ONDC_ENCRYPTION_PRIVATE_KEY="base64-x25519-private-key"

# ── ONDC routing / network (optional — sensible defaults exist in config.ts) ───
# ONDC_BAP_ID="your-subscriber-id"       # defaults to ONDC_SUBSCRIBER_ID
ONDC_BAP_URI="https://your-domain/ondc"
ONDC_GATEWAY_URL="https://staging.gateway.proteantech.in"
ONDC_REGISTRY_BASE_URL="https://staging.registry.ondc.org"
ONDC_DOMAIN="ONDC:RET10"
ONDC_COUNTRY_CODE="IND"
ONDC_CITY_CODE="std:080"
ONDC_TTL="PT30S"

# ── ONDC misc / ops (optional) ─────────────────────────────────────────────────
# ONDC_ALLOW_WORKBENCH_BAP_MISMATCH="0"  # "1" allowlists the staging-automation bap_id
# ONDC_ENABLE_DEBUG_ROUTES="0"
# ONDC_AUDIT_TOKEN="token-guarding-the-audit-endpoint"  # also guards the NO /forward POST
# ONDC_SITE_VERIFICATION_REQUEST_ID="registry-supplied-request-id"

# ── ONDC Network Observability (NO) — transaction-log forwarding ────────────────
# Forwards a Personal-Data-scrubbed copy of every ONDC exchange to ONDC's log
# collector as { type: "<action>", data: <scrubbed payload> } events (each API
# call = "<action>" + "<action>_response"). OFF until BOTH URL and TOKEN are set.
# The TOKEN is generated from the ONDC Network Observability portal and is
# PER-ENVIRONMENT: the pre-prod deployment holds the pre-prod token; the prod
# deployment holds the DIFFERENT prod token (from the registry "update
# participant info" step, post prod subscription). ONDC identifies the
# participant from the Bearer token (its `sub`), so nothing else rides the wire.
# The endpoint URL is not secret; the TOKEN is — keep it in .env.local / Vercel
# env, never here. See src/lib/ondc/network-observability.ts + docs/NETWORK_OBSERVABILITY.md.
#
# Either the OBSERVABILITY_* names or ONDC's own ONDC_NO_ENDPOINT / ONDC_NO_TOKEN
# aliases work; set one pair. These also resolve env-scoped names first, so
# ONDC_PREPROD_NO_TOKEN + ONDC_PROD_NO_TOKEN can coexist with ONDC_ENV picking
# the live one (prod collector: https://analytics-api.aws.ondc.org/v1/api/push-txn-logs).
# ONDC_OBSERVABILITY_URL="https://analytics-api-pre-prod.aws.ondc.org/v1/api/push-txn-logs"
# ONDC_OBSERVABILITY_TOKEN="paste-the-generated-NO-token-for-THIS-environment"   # SECRET
# ONDC_NO_ENDPOINT="https://analytics-api-pre-prod.aws.ondc.org/v1/api/push-txn-logs"  # alias of _URL
# ONDC_NO_TOKEN="paste-the-generated-NO-token-for-THIS-environment"              # alias of _TOKEN (SECRET)
# ONDC_OBSERVABILITY_ENABLED="1"          # set to "0" as a kill switch even when configured
# ONDC_OBSERVABILITY_AUTH_HEADER="Authorization"   # override if the collector uses a custom header
# ONDC_OBSERVABILITY_AUTH_SCHEME="Bearer "         # set to "" to send the raw token with no prefix
# ONDC_OBSERVABILITY_TIMEOUT_MS="10000"

# ── Payments (Razorpay — out-of-band settlement) ───────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"
